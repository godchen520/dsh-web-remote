{
  "name": "dsh-web-remote",
  "version": "5.2.5",
  "description": "DSH 手机/外网远程访问插件：免配置公网隧道 + 局域网 HTTPS 直连 + Tailscale P2P 直连 + 自定义端口 + 微信/飞书/Telegram/QQ官方/钉钉 机器人 + 通道健康监测。适配 DSH 0.1.2-rc.1 至 0.2.x（0.2.0-rc.2 实测）。",
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check lib/index.mjs && node test/test-dist.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "remote",
    "cloudflare",
    "tunnel",
    "monitor",
    "weixin",
    "feishu",
    "lark",
    "telegram",
    "qqbot",
    "qq",
    "dingtalk",
    "dingtalk-stream"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@tencent-connect/qqbot-connector": "^1.2.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "dingtalk-stream": "^2.1.5"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  }
}
